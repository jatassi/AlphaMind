[importlinter]
root_package = alphamind
include_external_packages = True
# Story ALP-501 — exclude TYPE_CHECKING-guarded imports from the graph so
# forward-reference seams (``run_context`` → ``debug_e2e.settings``) are
# treated as the type-time-only edges they are. The runtime
# ``run_context`` module never pulls ``debug_e2e`` into ``sys.modules``
# (verified by ``test_run_context_does_not_eagerly_import_debug_e2e``);
# import-linter must reflect that reality.
exclude_type_checking_imports = True

# ---------------------------------------------------------------------------
# Import-linter contracts.
#
# Foundation scaffolding installed by ALP-455:
#   - ``composition-root-layering`` (layered): scheduler/pipeline above the
#     domain packages.
#   - ``distillation-no-sqlalchemy`` (forbidden): distillation must not
#     import sqlalchemy directly or indirectly. ``ignore_imports`` entries
#     each cite the punch-list item that retires them.
#
# Tightening introduced by ALP-459 (this file):
#   - ``kernel-leaf`` / ``commands-leaf`` (forbidden): pin the kernel and
#     commands packages as leaves with no upward dependencies.
#   - ``distillation-not-persistence-models`` (layered): distillation sits
#     above persistence.models; the forbidden shape would carry 23
#     ``ignore_imports`` entries, so this is authored as a Layered
#     contract — the reverse direction (currently 0 chains) is the rule
#     actually enforced.
#   - ``decision-not-execution`` / ``portfolio_state-not-risk_guardrails``
#     (forbidden): enforce purity across these two layer boundaries with
#     architecturally-coherent ``ignore_imports`` exceptions for the
#     composition root and boundary translator that legitimately cross
#     each boundary. See contract-level comments for the architectural
#     rationale and the follow-up issue scheduled to retire each block.
#
# Layer-ordering convention (per the import-linter ``layers`` contract):
# layers are listed from highest to lowest. Higher layers may import lower
# layers; lower may not import higher. A literal ``A : B`` in a layer entry
# means A and B are non-independent siblings — they may import each other.
# ---------------------------------------------------------------------------

# Composition-root rule: only the orchestration entry points (``scheduler``
# and ``pipeline``) may consume the rest of the domain. The domain packages
# below them must not reach upward into composition.
[importlinter:contract:composition-root-layering]
name = Composition roots (scheduler, pipeline) sit above the domain
type = layers
layers =
    alphamind.scheduler
    alphamind.pipeline
    alphamind.analysis : alphamind.collector : alphamind.command_center : alphamind.config : alphamind.data_sources : alphamind.decision : alphamind.distillation : alphamind.execution : alphamind.feedback_loop : alphamind.persistence : alphamind.portfolio_state : alphamind.risk_guardrails : alphamind.state

# Forbidden contract: ``alphamind.distillation.*`` must not import sqlalchemy.
# Per audit finding L6, distillation is supposed to be a pure compute core
# but threads SQLAlchemy ``Session`` calls into the assembly path. Every
# entry in ``ignore_imports`` below is eliminated by the same punch-list
# item:
#
#     Punch-list #9 — Split distillation compute/load boundary
#     (Finding L6). For each ``q*/assemble.py``: create ``q*/loaders.py``
#     (DB shell) and ``q*/compute.py`` (pure core). Once the loaders own
#     all session reads, the compute modules drop sqlalchemy entirely.
#
# When that punch-list item lands, the corresponding entry is removed
# and the contract tightens automatically. Two indirect violations
# (q7.correlation_regime_change -> data_sources._common -> sqlalchemy, and
# replay_harness.engine -> persistence.models -> sqlalchemy) are also
# present and would be cleared by punch-list #22 (split data_sources/_common)
# and the same #9 split respectively.
[importlinter:contract:distillation-no-sqlalchemy]
name = Distillation compute core has no sqlalchemy imports
type = forbidden
source_modules =
    alphamind.distillation
forbidden_modules =
    sqlalchemy
ignore_imports =
    # Punch-list #9 (ALP-467): each direct sqlalchemy import disappears when the
    # corresponding assemble.py splits into loaders.py (keeps sqlalchemy)
    # and compute.py (loses sqlalchemy). The ALP-467 pilot retires the
    # gap.py and flow_classification.py entries (they delegate to
    # compute/loaders submodules now) plus adds entries for the new
    # ``_repository_sql.py`` (concrete SQL impl — keeps sqlalchemy) and the
    # ``q*/<sub>_loaders.py`` shells (which intentionally keep sqlalchemy).
    alphamind.distillation.baselines -> sqlalchemy
    alphamind.distillation.calibration -> sqlalchemy
    alphamind.distillation.contract_scope -> sqlalchemy
    alphamind.distillation.orchestrator -> sqlalchemy
    # ALP-709: the invocation-archive write step invokes
    # ``analysis.qualitative_research.loaders.compute_sentiment_inflow_metrics``
    # so the operator data-health snapshot carries inter-baseline news-flow
    # telemetry. The helper reuses three private loader functions
    # (``_load_recent_sentiment_baselines``, ``_load_article_volume_by_ticker``,
    # ``_load_window_sentiment_mean_by_ticker``); duplicating them into
    # distillation would fork the query shape the qualitative loader uses.
    # Sibling-layer ``analysis : distillation`` already permits the edge in
    # ``composition-root-layering``; the indirect ``-> sqlalchemy`` chain
    # this creates is the same shape the already-grandfathered direct
    # ``orchestrator -> sqlalchemy`` edge above already establishes. Retires
    # when the punch-list #9 split lands and the orchestrator's own
    # ``-> sqlalchemy`` entry retires.
    alphamind.distillation.orchestrator -> alphamind.analysis.qualitative_research.loaders
    alphamind.distillation.q12_corporate_actions -> sqlalchemy
    alphamind.distillation.q1.assemble -> sqlalchemy
    alphamind.distillation.q3.anomalies -> sqlalchemy
    alphamind.distillation.q3.assemble -> sqlalchemy
    alphamind.distillation.q3.atm_iv_baseline -> sqlalchemy
    alphamind.distillation.regime -> sqlalchemy
    alphamind.distillation.replay_harness.engine -> sqlalchemy
    alphamind.distillation.sector_assembly -> sqlalchemy
    # ALP-467 piloted modules — IO shells / orchestration shims keep sqlalchemy
    # because they construct the production repository or own session-bound
    # writes. The corresponding pure compute cores are q1/gap_compute and
    # q3/flow_classification_compute; both are pinned ORM-free by the new
    # ``distillation-compute-no-sqlalchemy`` contract below. The
    # ``flow_classification_loaders`` module is itself ORM-free — it
    # consumes the Protocol only.
    alphamind.distillation._repository_sql -> sqlalchemy
    alphamind.distillation.q1.gap -> sqlalchemy
    alphamind.distillation.q1.gap_loaders -> sqlalchemy
    alphamind.distillation.q3.flow_classification -> sqlalchemy
    # ALP-484 piloted modules — q3 anomalies / atm_iv_baseline / etf_iv_divergence
    # IO shells keep sqlalchemy for the same reason: they own the session-bound
    # reads + the IV-rank UPSERT. The corresponding compute cores are
    # ORM-free under ``distillation-compute-no-sqlalchemy`` below. The
    # whole-category ``q3._loaders`` composes the per-sub loaders plus the
    # universe / sector-topology / flow-z-score / sector-ETF-membership
    # reads previously embedded in ``q3.assemble`` — so it carries the
    # session reads ``q3.assemble`` no longer does.
    alphamind.distillation.q3._loaders -> sqlalchemy
    alphamind.distillation.q3.anomalies_loaders -> sqlalchemy
    alphamind.distillation.q3.atm_iv_baseline_loaders -> sqlalchemy
    alphamind.distillation.q3.etf_iv_divergence_loaders -> sqlalchemy
    # ALP-485 piloted modules — q6 IO shell + session-accepting shim keep
    # sqlalchemy because the loader owns the funding-stress / market-liquidity
    # composite-refresh writes (``session.flush()``) and the assemble shim
    # threads a ``Session`` into ``load_q6_inputs``. The per-classifier
    # compute cores are ORM-free under ``distillation-compute-no-sqlalchemy``
    # below.
    alphamind.distillation.q6._loaders -> sqlalchemy
    alphamind.distillation.q6.assemble -> sqlalchemy
    # ALP-486 piloted modules — q7 IO shell + per-sub orchestration shims +
    # per-sub loader thin aliases keep sqlalchemy because ``q7._loaders``
    # owns every session-bound read (per-ticker daily-bar closes, macro
    # series, news_articles, distillation_pair_lag) plus the intra-sector
    # ``correlation_divergence`` event writes. The per-sub orchestration
    # shims (``q7/<sub>.py``) and the per-sub loader thin aliases
    # (``q7/<sub>_loaders.py``) re-export from ``q7._loaders`` and so carry
    # the sqlalchemy edge transitively. The per-sub ``*_compute.py`` cores
    # are ORM-free under ``distillation-compute-no-sqlalchemy`` below.
    alphamind.distillation.q7._loaders -> sqlalchemy
    alphamind.distillation.q7.assemble -> sqlalchemy
    alphamind.distillation.q7.breadth_internals -> sqlalchemy
    alphamind.distillation.q7.correlation_regime_change -> sqlalchemy
    alphamind.distillation.q7.cross_sector_rotation -> sqlalchemy
    alphamind.distillation.q7.intermarket_regime -> sqlalchemy
    alphamind.distillation.q7.intra_sector_correlation -> sqlalchemy
    alphamind.distillation.q7.lead_lag -> sqlalchemy
    # ALP-487 piloted modules — qualitative_derived split into
    # qualitative/ package. The session-bound back-compat shim
    # (``qualitative_derived`` for the legacy public API) keeps sqlalchemy
    # because it constructs the production repository. The per-classifier
    # compute cores are ORM-free under
    # ``distillation-compute-no-sqlalchemy`` below; the per-classifier
    # loaders consume the Protocol only and so carry no sqlalchemy edge.
    alphamind.distillation.qualitative_derived -> sqlalchemy
    # ALP-530 (per-ticker realized-vol substrate). ``realized_vol`` keeps a
    # mixed shape: the pure ``compute_trailing_realized_vol`` is ORM-free
    # and pinned under ``distillation-compute-no-sqlalchemy`` below; the
    # IO-shell ``persist_per_ticker_realized_vol`` + ``read_realized_vol_map``
    # legitimately carry sqlalchemy (UPSERT into ``ticker_realized_vol``
    # plus the consumer-side latest-per-ticker read). The same punch-list
    # #9 split that retires the q*/loaders entries above will retire this
    # one — at that point the IO shell moves to ``realized_vol_loaders.py``
    # and the read function becomes Protocol-typed.
    alphamind.distillation.realized_vol -> sqlalchemy
    # Indirect via persistence.models (also retired by punch-list #9: once
    # the distillation modules consume a loaders/repository protocol
    # instead of importing ORM declarative classes directly, the indirect
    # path to sqlalchemy via persistence.models disappears).
    alphamind.distillation.baselines -> alphamind.persistence.models
    alphamind.distillation.calibration -> alphamind.persistence.models
    alphamind.distillation.contract_scope -> alphamind.persistence.models
    alphamind.distillation.orchestrator -> alphamind.persistence.models
    alphamind.distillation.q12_corporate_actions -> alphamind.persistence.models
    alphamind.distillation.regime -> alphamind.persistence.models
    alphamind.distillation.replay_harness.engine -> alphamind.persistence.models
    alphamind.distillation.sector_assembly -> alphamind.persistence.models
    # ALP-467 piloted modules — IO shells reach persistence.models for ORM
    # queries / writes. The pure-compute cores have no such edges; the
    # orchestration shims (q1.gap, q3.flow_classification) only import the
    # sqlalchemy ``Session`` type so persistence.models is reached only via
    # the SqlDistillationRepository and the gap_loaders write path.
    alphamind.distillation._repository_sql -> alphamind.persistence.models
    alphamind.distillation.q1.gap_loaders -> alphamind.persistence.models
    # ALP-533 — ``persistence.asset_universe_queries`` carries the shared ADV
    # SELECT + int-to-float coercion previously duplicated between
    # ``SqlDistillationRepository.load_ticker_adv`` (sync) and
    # ``SqlAdvLookup.get_adv_shares`` (async). The helper module reaches
    # sqlalchemy directly so each adapter can execute the returned ``Select``
    # against its own session shape; the IO-shell carve-out matches the
    # existing ``_repository_sql -> alphamind.persistence.models`` exception
    # above and retires under the same punch-list #9 split.
    alphamind.distillation._repository_sql -> alphamind.persistence.asset_universe_queries
    # ALP-484 piloted modules — q3 IO shells reach persistence.models for the
    # same reason: ORM queries (and the IV-rank UPSERT) live here, not in
    # the corresponding pure compute cores. ``q3._loaders`` composes the
    # per-sub loaders plus the legacy session-bound reads lifted out of
    # ``q3.assemble``.
    alphamind.distillation.q3._loaders -> alphamind.persistence.models
    alphamind.distillation.q3.anomalies_loaders -> alphamind.persistence.models
    alphamind.distillation.q3.atm_iv_baseline_loaders -> alphamind.persistence.models
    alphamind.distillation.q3.etf_iv_divergence_loaders -> alphamind.persistence.models
    # ALP-485 piloted modules — q6 IO shell reaches persistence.models for the
    # FRED-series reads (``MacroObservations``), the macro-release surprise
    # scan (``EventCalendar``), and the composite-state row override
    # (``DistillationCompositeState``). The pure compute cores have no such
    # edges.
    alphamind.distillation.q6._loaders -> alphamind.persistence.models
    # ALP-486 piloted modules — q7 IO shell reaches persistence.models for
    # the per-ticker daily-bar reads (``OhlcvBars``), the macro-series reads
    # (``MacroObservations``), the news-article scan
    # (``NewsArticles`` / ``NewsArticleTickers``), the persisted pair-lag
    # estimate (``DistillationPairLag``), and the divergence-event writes
    # (``DistillationEventHistory`` / ``AssetUniverse`` /
    # ``SectorClassification``). The per-sub orchestration shims and
    # per-sub loader thin aliases re-export from ``q7._loaders``; the
    # ``intra_sector_correlation`` shim additionally reaches persistence.models
    # via the divergence-event write helper. The pure compute cores have no
    # such edges.
    alphamind.distillation.q7._loaders -> alphamind.persistence.models
    # ALP-530 IO shell — ``realized_vol.persist_per_ticker_realized_vol`` and
    # ``realized_vol.read_realized_vol_map`` import ``TickerRealizedVolRow``
    # for the upsert + read paths. Retires under the same punch-list #9
    # split alongside the q*/loaders entries above.
    alphamind.distillation.realized_vol -> alphamind.persistence.models

# Forbidden contract (ALP-467 pilot): pure-compute cores split out by the
# distillation compute/load boundary pilot must never import sqlalchemy.
# This is the architectural seam that lets the per-category indicator compute
# step run ``asyncio.TaskGroup``-parallel over ``asyncio.to_thread(compute_*)``
# calls — no shared mutable session means no "Session is already flushing"
# InvalidRequestError. Compute modules expand here as further sub-modules
# split out per the multi-quarter propagation tracked as ALP-467
# follow-ups (q6 / q7 / qualitative / remaining q3 categories).
[importlinter:contract:distillation-compute-no-sqlalchemy]
name = Distillation compute cores have no sqlalchemy imports
type = forbidden
source_modules =
    alphamind.distillation.q1.anomalies_compute
    alphamind.distillation.q1.divergence_compute
    alphamind.distillation.q1.gap_compute
    alphamind.distillation.q1.indicators_compute
    alphamind.distillation.q1.relative_performance_compute
    alphamind.distillation.q1.trend_state_compute
    alphamind.distillation.q1.volume_profile_compute
    alphamind.distillation.q3.anomalies_compute
    alphamind.distillation.q3.atm_iv_baseline_compute
    alphamind.distillation.q3.etf_iv_divergence_compute
    alphamind.distillation.q3.flow_classification_compute
    alphamind.distillation.q6.dollar_attribution_compute
    alphamind.distillation.q6.funding_stress_compute
    alphamind.distillation.q6.inflation_compute
    alphamind.distillation.q6.macro_surprise_compute
    alphamind.distillation.q6.market_liquidity_compute
    alphamind.distillation.q6.yield_curve_compute
    alphamind.distillation.q7._helpers_compute
    alphamind.distillation.q7.breadth_internals_compute
    alphamind.distillation.q7.correlation_regime_change_compute
    alphamind.distillation.q7.cross_sector_rotation_compute
    alphamind.distillation.q7.intermarket_regime_compute
    alphamind.distillation.q7.intra_sector_correlation_compute
    alphamind.distillation.q7.lead_lag_compute
    alphamind.distillation.qualitative.news_price_divergence_compute
    alphamind.distillation.qualitative.prediction_market_deltas_compute
    alphamind.distillation.qualitative.sentiment_percentile_compute
forbidden_modules =
    sqlalchemy
    alphamind.persistence.models

# ---------------------------------------------------------------------------
# ALP-459 contracts.
# ---------------------------------------------------------------------------

# Leaf contract: ``alphamind._kernel`` carries the shared primitives that
# every domain layer depends on, so it must not import any sibling
# top-level alphamind package. Forbidden modules are enumerated explicitly
# rather than collapsing to ``alphamind`` because grimp raises
# ``ValueError: Modules have shared descendants`` when a source and a
# forbidden module are ancestor/descendant.
[importlinter:contract:kernel-leaf]
name = _kernel is a leaf — no upward dependencies on sibling packages
type = forbidden
source_modules =
    alphamind._kernel
forbidden_modules =
    alphamind.analysis
    alphamind.collector
    alphamind.command_center
    alphamind.commands
    alphamind.config
    alphamind.data_sources
    alphamind.decision
    alphamind.distillation
    alphamind.execution
    alphamind.feedback_loop
    alphamind.persistence
    alphamind.pipeline
    alphamind.portfolio_state
    alphamind.risk_guardrails
    alphamind.scheduler
    alphamind.scripts
    alphamind.state

# Leaf contract: ``alphamind.commands`` is the engine/PM envelope vocabulary
# extracted in ALP-458. It may import ``alphamind._kernel`` but no other
# sibling — ``commands`` is intended to be a typed value-object package
# that the rest of the system consumes downward.
[importlinter:contract:commands-leaf]
name = commands is a leaf — may only import _kernel
type = forbidden
source_modules =
    alphamind.commands
forbidden_modules =
    alphamind.analysis
    alphamind.collector
    alphamind.command_center
    alphamind.config
    alphamind.data_sources
    alphamind.decision
    alphamind.distillation
    alphamind.execution
    alphamind.feedback_loop
    alphamind.persistence
    alphamind.pipeline
    alphamind.portfolio_state
    alphamind.risk_guardrails
    alphamind.scheduler
    alphamind.scripts
    alphamind.state

# Forbidden contract: ``alphamind.feedback_loop`` is read-only over trading
# state — it measures and proposes, never mutating live trading-state records.
# The clearest enforceable proxy is that it must not import the execution layer
# (the writer of trading state). The one thesis-resolution authoring exception
# (ALP-834 handoff) deliberately lives in ``analysis/thesis_resolution/`` + a
# ``run_invocation`` step, NOT in ``feedback_loop``, so this stays a clean ban.
[importlinter:contract:feedback_loop-no-execution]
name = feedback_loop is read-only over trading state — never imports execution
type = forbidden
source_modules =
    alphamind.feedback_loop
forbidden_modules =
    alphamind.execution

# Forbidden contract: ``alphamind.feedback_loop.metrics`` holds the pure metric
# cores (ALP-882). Functional core / imperative shell: a metric's ``compute`` is
# a pure function over a ``WindowDataset``; all DB I/O lives in the loader shell
# (``feedback_loop.dataset.load_window``). The cores therefore never reach the
# session / persistence / repository layer. The registry's dynamic discovery
# (``importlib.import_module``) is not a static import, so it is invisible here —
# only a metric module that *statically* imports sqlalchemy trips this.
[importlinter:contract:feedback-loop-metric-cores-no-sqlalchemy]
name = feedback_loop metric cores are pure — no sqlalchemy / session / repository imports
type = forbidden
source_modules =
    alphamind.feedback_loop.metrics
    alphamind.feedback_loop.citation.parser
    alphamind.feedback_loop.citation.chain
forbidden_modules =
    sqlalchemy
    alphamind.persistence.models
    alphamind.persistence.session
    alphamind.state.repository

# Layered contract: ``alphamind.distillation`` sits above
# ``alphamind.persistence.models``. The forbidden shape that would
# directly ban ``distillation -> persistence.models`` carries 23
# ``ignore_imports`` entries today — a textbook story-spec scenario
# where the layered form is preferred. The reverse direction
# (``persistence.models -> distillation``) is currently 0 chains and is
# what the contract enforces: persistence.models never reaches up into
# the compute core. The 23 distillation-side imports are kept on file
# in ``distillation-no-sqlalchemy``'s indirect ``ignore_imports`` block
# and disappear when punch-list #9 (ALP-467) splits the assemble.py
# files into loaders/compute.
[importlinter:contract:distillation-not-persistence-models]
name = distillation sits above persistence.models
type = layers
layers =
    alphamind.distillation
    alphamind.persistence.models

# Architectural exception: ``submit_envelope/`` is the PM MCP composition
# root (python-architecture skill §C4). Composition roots legitimately
# wire concrete implementations across layers; this is the wiring layer.
# The contract still enforces purity on every other ``decision/*`` module.
# ALP-464 (06b) decomposed the single-file ``submit_envelope.py`` into a
# five-submodule package; the per-submodule exceptions below replace the
# pre-decomposition single ``submit_envelope -> execution.*`` ignores.
# ALP-470 (08c) hoisted the cross-cutting state-persistence primitives
# (tables, repository, invocation_context, config, process_lifetime,
# typed record facades) out of ``execution`` and into the new top-level
# ``alphamind.state`` package; the corresponding three ``dispatch ->
# state.tables.*`` and one ``persist -> state.config`` edges are now
# decision -> state crossings (not decision -> execution) and so no
# longer require an ignore here. ALP-470 also renamed the surviving
# OMS-only write-path subpackage from ``execution/state_persistence/
# write_paths/`` to ``execution/write_paths/`` since nothing else
# remained beneath ``state_persistence/``. The ``persist ->
# execution.write_paths.command_execution`` edge remains the load-bearing
# execution-side wiring entry.
#
# ALP-482 audit conclusion: keep this package here rather than hoisting
# to a top-level ``composition_roots/``. Post-06b, ``submit_envelope/``
# is not a pure assembler — ``process``, ``dispatch``, and ``server``
# carry PM request-routing logic alongside the wiring. The runtime
# ``decision -> execution`` edges are two top-level imports
# (``process -> execution.oms.command_ids``,
# ``persist -> execution.write_paths.command_execution``) plus four function-local
# fallbacks inside ``dispatch.py``; the remaining ``submit_envelope.*``
# entries below are ``TYPE_CHECKING``-only and carry no runtime cost.
# These ``submit_envelope.*`` exceptions are permanent architectural
# carve-outs, not a debt item. (The trailing ``state.config ->
# execution.corporate_actions.config`` entry below is a separate
# transitive chain with its own retirement note.)
[importlinter:contract:decision-not-execution]
name = decision/ has no upward imports of execution/
type = forbidden
source_modules =
    alphamind.decision
forbidden_modules =
    alphamind.execution
ignore_imports =
    # Architectural exception: see contract header — submit_envelope/ is
    # the PM MCP composition root (python-architecture §C4). ALP-501 turned
    # on ``exclude_type_checking_imports = True`` globally so several
    # previously-listed ``submit_envelope.*`` entries that were
    # ``TYPE_CHECKING``-only no longer register as graph edges and are
    # dropped from this block. The remaining entries are runtime
    # function-local lazy imports that still register and must be ignored.
    alphamind.decision.portfolio_manager.submit_envelope.dispatch -> alphamind.execution.broker_adapter
    alphamind.decision.portfolio_manager.submit_envelope.dispatch -> alphamind.execution.broker_adapter.errors
    alphamind.decision.portfolio_manager.submit_envelope.dispatch -> alphamind.execution.broker_adapter.order_options
    alphamind.decision.portfolio_manager.submit_envelope.dispatch -> alphamind.execution.oms.broker_dispatch
    alphamind.decision.portfolio_manager.submit_envelope.persist -> alphamind.execution.write_paths.command_execution
    alphamind.decision.portfolio_manager.submit_envelope.process -> alphamind.execution.oms.command_ids
    # ALP-711 — ``submit_envelope.server.build_broker_routing_kwargs`` lazily
    # constructs the Alpaca-backed TradingClient + AccountStateQueries inside
    # the PM subprocess worker (the live client is not picklable across the
    # subprocess boundary, so the picklable triple ``(venue_config,
    # execution_mode, execution_config)`` crosses instead and the client is
    # built on the worker side). Same composition-root carve-out as the
    # ``dispatch`` entries above.
    alphamind.decision.portfolio_manager.submit_envelope.server -> alphamind.execution.broker_adapter.client_factory
    alphamind.decision.portfolio_manager.submit_envelope.server -> alphamind.execution.broker_adapter.queries
    # ALP-738 — ``submit_envelope.server`` also lazily builds the Alpaca-backed
    # quote source (``build_broker_routing_kwargs``) and invokes the
    # marketable-entry rewrite (``_handle_submit_envelope`` step 3.5) inside the
    # PM composition root, re-pricing an enter-now equity entry against the live
    # touch before broker dispatch. Re-pricing against the live quote is an
    # execution concern realized at the composition root — the same permanent
    # carve-out as the ALP-711 entries above.
    alphamind.decision.portfolio_manager.submit_envelope.server -> alphamind.execution.broker_adapter.entry_pricing
    alphamind.decision.portfolio_manager.submit_envelope.server -> alphamind.execution.broker_adapter.quotes
    # ALP-836 — atomicity-first order persistence. ``submit_envelope.dispatch``
    # interleaves the per-command pre-commit / backfill / teardown
    # (``execution.write_paths.command_execution.atomic``) with the broker dispatch in the PM
    # composition root, and ``submit_envelope.server`` finalizes the envelope-level
    # audit (pm_decision + command_execution stamp) via the same module after the loop. Same
    # permanent composition-root carve-out as the ``persist -> ...command_execution`` edge.
    alphamind.decision.portfolio_manager.submit_envelope.dispatch -> alphamind.execution.write_paths.command_execution.atomic
    alphamind.decision.portfolio_manager.submit_envelope.server -> alphamind.execution.write_paths.command_execution.atomic
    # ALP-470 hoisted ``state.config`` out of execution but its
    # ``CorporateActionsConfig`` field still reaches into
    # ``execution.corporate_actions.config`` (the per-feature CA knobs).
    # The composition-root ``submit_envelope.persist`` accordingly carries
    # a transitive ``decision -> state.config -> execution.corporate_actions
    # .config`` chain that import-linter reports as a decision -> execution
    # crossing. Retires when ``CorporateActionsConfig`` is hoisted to a
    # layer-neutral location (no ticket filed yet).
    alphamind.state.config -> alphamind.execution.corporate_actions.config

# ``portfolio_state`` must not reach upward into ``risk_guardrails``.
# Boundary translators live on the consumer side (python-architecture §B3).
#
# ALP-648 — this contract also forecloses the load-order ``ImportError``
# scenario formerly documented in prose on the
# ``risk_guardrails/regime_adaptation`` and ``risk_guardrails/breach_behavior``
# package docstrings: a function-module under either subpackage could in
# principle have triggered a circular re-entry by transitively reaching
# back into ``portfolio_state`` while the subpackage was still mid-load.
# That class of cycle cannot form while this contract holds, regardless of
# the re-export order inside either ``__init__.py``.
[importlinter:contract:portfolio_state-not-risk_guardrails]
name = portfolio_state/ has no upward imports of risk_guardrails/
type = forbidden
source_modules =
    alphamind.portfolio_state
forbidden_modules =
    alphamind.risk_guardrails

# Story ALP-501 — production scheduler code must not import ``debug_e2e``
# at module-load time. The debug-e2e package carries the synthetic
# portfolio + log-only broker shims + wipe-and-seed helper; pulling any
# of it into the production import graph would (a) execute the
# ``-debug-e2e.db`` suffix-guarded seeder branch where it does not
# belong and (b) couple production code to dev-only test fixtures.
#
# ``scheduler.__main__`` is the SOLE production module that names
# ``debug_e2e`` symbols, and it does so via ``importlib.import_module``
# inside ``_run_debug_e2e`` — grimp can't statically resolve dynamic
# module names, so those edges are invisible to the contract while still
# executing normally. ``run_context`` declares the ``DebugE2ESettings``
# field via ``TYPE_CHECKING`` only and the ``exclude_type_checking_imports``
# session flag drops that forward-reference seam from the graph.
[importlinter:contract:debug-e2e-forbidden-in-production]
name = Production scheduler code must not import debug_e2e
type = forbidden
source_modules =
    alphamind.scheduler.__main__
    alphamind.scheduler.orchestrator
    alphamind.scheduler.fill_collection_inputs
    alphamind.scheduler.command_execution_dispatch
    alphamind.scheduler.run_context
    alphamind.scheduler.driver
    alphamind.scheduler.emergency
    alphamind.scheduler.invocation
    alphamind.scheduler.runtime
    alphamind.scheduler.supervisor
    alphamind.scheduler.session
    alphamind.scheduler.logging_setup
    alphamind.pipeline
forbidden_modules =
    alphamind.scheduler.debug_e2e

# ALP-857 / W4b — the isolated safety core (breach detection + price-staleness,
# the lone no-floor safety item) is its own out-of-process service. Per ADR-0004
# it must import NEITHER pipeline NOR monitor internals: a freeze of the monitor
# proper must not be able to freeze the safety core, and the safety core must not
# carry the monitor's DB-writing / orchestration machinery. This is an
# architectural invariant, so it lives here (not a grep test).
#
# The safety core legitimately imports the shared price-stream transport
# (``underlying_stream``), the monitor ``session`` value object, and
# ``logging_setup`` — none are forbidden. It must not reach the supervisor (a
# loop-resident watchdog it deliberately escapes), the breach-loop / cascade /
# emergency / bracket-stops / greeks / entry-window / fill / activities task
# packages, the control surface, the monitor ``__main__`` composition root, or
# the pipeline / scheduler composition roots. Each is enumerated (grimp rejects
# forbidding an ancestor of the source package).
[importlinter:contract:safety-core-isolation]
name = Safety core imports neither pipeline nor monitor internals
type = forbidden
source_modules =
    alphamind.execution.continuous_monitor.safety_core
forbidden_modules =
    alphamind.pipeline
    alphamind.scheduler
    alphamind.execution.continuous_monitor.supervisor
    alphamind.execution.continuous_monitor.breach_loop
    alphamind.execution.continuous_monitor.cascade_dispatch
    alphamind.execution.continuous_monitor.emergency_trigger
    alphamind.execution.continuous_monitor.bracket_stops
    alphamind.execution.continuous_monitor.greeks_refresh
    alphamind.execution.continuous_monitor.entry_window
    alphamind.execution.continuous_monitor.fill_stream_consumer
    alphamind.execution.continuous_monitor.activities_backfill
    alphamind.execution.continuous_monitor.control
